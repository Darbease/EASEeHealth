# ─── Confidential AI Attester (Phase 1+) ─────────────────────────
# Hosted TEE inference (dev preview). Request a key from the Attester team.
# The attester-proof-adapter falls back to the deterministic evaluator when unset.
INFERENCE_API_KEY=
INFERENCE_BASE_URL=https://confidential-ai-dev-preview.cldev.cloud
INFERENCE_MODEL=gemma4
ATTESTER_ADAPTER_PORT=3007
